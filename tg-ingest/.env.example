# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Нужны только для первого входа. Дальше Telethon использует файл сессии.
TG_PHONE=+79990000000
# Только если на аккаунте включена двухфакторная аутентификация.
# Пусто -> Telethon спросит пароль интерактивно при первом входе.
TG_2FA_PASSWORD=

# Файл сессии (SQLite). Храните его как секрет и не коммитьте.
TG_SESSION=state/tg_ingest

# Дополнительные каналы через запятую: @handle или t.me-ссылка.
# Основной список берётся из бэкенда (все каналы, на которые подписаны пользователи).
TG_CHANNELS=

BACKEND_URL=http://localhost:8000
INGEST_PATH=/api/ingest/posts
# Список каналов для подписки твинка (требует X-Ingest-Token).
CHANNELS_PATH=/api/ingest/channels
CHANNELS_SYNC_INTERVAL=60
# Пауза перед повторной попыткой зайти в канал, который не удалось разрезолвить.
CHANNEL_JOIN_RETRY=600
# Искусственная задержка перед вступлением, чтобы не нарушать ToS Telegram.
# Случайная пауза JOIN_DELAY_MIN..JOIN_DELAY_MAX секунд на каждый новый канал.
JOIN_DELAY_MIN=3
JOIN_DELAY_MAX=8
# Сколько каналов максимум за один цикл синхронизации.
JOIN_BATCH=5
# Жёсткий дневной лимит вступлений (0 = без лимита). Счётчик хранится в JOIN_STATE.
JOIN_DAILY_LIMIT=20
JOIN_STATE=state/joins.json
# Сколько аватарок докачивать за цикл (фоном, чтобы не тормозить подписки).
AVATAR_BATCH=3
# Должен совпадать с INGEST_TOKEN в back/.env
INGEST_TOKEN=
HTTP_TIMEOUT=30
INGEST_RETRIES=3
