# --- Compose ---
POSTGRES_DB=alfafuture
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
FRONT_PORT=3000
API_PORT=8000

# --- Backend ---
ENVIRONMENT=production
# openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-at-least-32-bytes
CORS_ORIGINS=http://localhost:3000

# Shared secret for trusted post ingestion.
# Empty = ingest endpoints are open.
INGEST_TOKEN=

# --- LLM layer ---
# stub = offline fallbacks, openai = any OpenAI-compatible gateway.
LLM_PROVIDER=stub
LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.6-35b-a3b
LLM_FAST_MODEL=google/gemma-4-26b-a4b-it
LLM_AGENT_ENABLED=false
LLM_ML_ENABLED=false

# --- RSS ---
RSS_POLL_ENABLED=false
RSS_FEEDS=
RSSHUB_BASE_URL=http://rsshub:1200
RSSHUB_CACHE_EXPIRE=300

# --- Seed / demo accounts ---
DEMO_LOGIN=demo
DEMO_PASSWORD=demo
DEMO_FULL_LOGIN=demo_full
DEMO_FULL_PASSWORD=demo

# --- Host paths ---
# Directory with df_*_hack.csv for seed.py.
BACK_DATA_DIR=./back/data
