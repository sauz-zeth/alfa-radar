# --- App ---
APP_NAME=Alfa Future News Analytics
ENVIRONMENT=local
API_PREFIX=/api
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/alfafuture
DATABASE_ECHO=false

# --- Auth ---
JWT_SECRET=change-me-in-production-use-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- LLM layer (see README, section "LLM layer") ---
# stub   — offline deterministic fallbacks, no API calls
# openai — any OpenAI-compatible gateway
LLM_PROVIDER=openai
LLM_BASE_URL=https://changellenge.up.railway.app/v1
# Для российских хостингов: https://api.alfahack-gateway26.ru/v1
LLM_API_KEY=
# strong role for full analysis; weak role for short routing questions.
# Empty alias -> falls back to the legacy variable on the right.
LLM_MODEL=moonshotai/kimi-k2.6          # strong (legacy name)
LLM_FAST_MODEL=google/gemma-4-26b-a4b-it  # weak (legacy name)
LLM_STRONG_MODEL=                        # optional -> LLM_MODEL
LLM_WEAK_MODEL=                          # optional -> LLM_FAST_MODEL
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_AGENT_ENABLED=true
LLM_ML_ENABLED=true

# --- Ingestion (internal) ---
# If set, POST/GET /api/ingest/posts require header X-Ingest-Token: <value>.
INGEST_TOKEN=
# Shared directory for uploaded post images (relative paths are stored in PostgreSQL).
MEDIA_ROOT=media

# --- Async ML feed worker (ml_pipeline, compose service ml-worker) ---
ML_WORKER_ENABLED=false
ML_WORKER_POLL_INTERVAL_SECONDS=10
ML_WORKER_BATCH_SIZE=20
ML_WORKER_LEASE_SECONDS=300
ML_WORKER_MAX_ATTEMPTS=5
# Importance threshold: primary results score above it, weak results stay visible below it (max 10).
ML_FEED_THRESHOLD=30
ML_KIMI_MODEL=moonshotai/kimi-k2.6
ML_SCREENING_MODEL=model service
ML_ARTIFACT_ROOT=ml_artifact

# Comma-separated RSS/Atom feeds for scripts/ingest_rss.py.
RSS_FEEDS=
RSSHUB_BASE_URL=http://rsshub:1200
RSSHUB_CACHE_EXPIRE=300
# Background polling for RSS sources subscribed by users.
RSS_POLL_ENABLED=true
RSS_POLL_INTERVAL_SECONDS=300
RSS_POLL_INITIAL_DELAY_SECONDS=20
RSS_POLL_CONCURRENCY=5
RSS_POLL_ITEMS_LIMIT=10

# --- Seed ---
DATA_DIR=data
SEED_COMPANY_LIMIT=0
SEED_WITH_PAYMENTS=true
DEMO_LOGIN=demo
DEMO_PASSWORD=demo
DEMO_FULL_LOGIN=demo_full
DEMO_FULL_PASSWORD=demo
